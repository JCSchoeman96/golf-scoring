    {
      "attribute": [
        "basis_source"
      ],
      "base_filter": null,
      "check": "basis_source IN ('official_or_preloaded', 'player_declared', 'committee_deemed', 'committee_override')",
      "name": "handicap_snapshots_basis_source_valid"
    },
    {
      "attribute": [
        "basis_source"
      ],
      "base_filter": null,
      "check": "(basis_source IN ('official_or_preloaded', 'player_declared')\n  AND source_handicap_index IS NOT NULL\n  AND deemed_handicap_basis IS NULL)\nOR\n(basis_source IN ('committee_deemed', 'committee_override')\n  AND deemed_handicap_basis IS NOT NULL\n  AND source_handicap_index IS NULL)\n",
      "name": "handicap_snapshots_official_basis_shape"
    },
    {
      "attribute": [
        "basis_source"
      ],
      "base_filter": null,
      "check": "(basis_source <> 'committee_override') OR (override_reason IS NOT NULL AND btrim(override_reason) <> '')",
      "name": "handicap_snapshots_override_reason_required"
    },
    {
      "attribute": [
        "confirmed_at"
      ],
      "base_filter": null,
      "check": "(confirmed_at IS NULL)\nOR (\n  ((confirmed_by_staff_user_id IS NOT NULL)::int +\n   (confirmed_by_round_entry_id IS NOT NULL)::int) = 1\n)\n",
      "name": "handicap_snapshots_confirmer_shape"
    },
    {
      "attribute": [
        "course_handicap_unrounded"
      ],
      "base_filter": null,
      "check": "(course_handicap_unrounded IS NULL\n  AND course_handicap_rounded IS NULL\n  AND built_at IS NULL)\nOR\n(course_handicap_unrounded IS NOT NULL\n  AND course_handicap_rounded IS NOT NULL\n  AND built_at IS NOT NULL)\n",
      "name": "handicap_snapshots_course_handicap_build_consistency"
    }
